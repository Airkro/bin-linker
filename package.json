  "license": "MIT",
  "author": {
    "name": "Eric Chen"
  },
  "keywords": [],
  "homepage": "https://github.com/Airkro/bin-linker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Airkro/bin-linker.git"
  },
  "bugs": {
    "url": "https://github.com/Airkro/bin-linker/issues"
  },
  "bin": {
    "bin-linker": "lib/index.mjs"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "fmt:prettier": "prettier -w .",
    "lint:eslint": "eslint . --quiet --fix --concurrency=auto",
    "lint:staged": "nice-move lint staged",
    "lint:type": "tsc -p tsconfig.json",
    "prepare": "nice-move git hooks",
    "prepublishOnly": "pnpm run lint:type && pnpm test && pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@bring-it/npm": "^0.9.6",
    "@nice-move/all-in-base": "^0.8.13",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "garou": "^0.9.21",
    "prettier": "~3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": "^10.33.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "prettier": "@nice-move/all-in-base/prettier"
}
